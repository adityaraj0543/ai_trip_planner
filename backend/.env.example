NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Generate a unique secret with at least 32 characters. Keep it private.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/TripGenius

# Razorpay TEST MODE credentials. Never commit real secrets.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Google Maps JavaScript API key. Restrict this key by HTTP referrer in Google Cloud.
GOOGLE_MAPS_API_KEY=your_google_maps_browser_key
